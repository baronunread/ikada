---
import PageHead from "../components/docs/PageHead.astro";
import Pager from "../components/docs/Pager.astro";
import Docs from "../layouts/Docs.astro";
import { colorNames, colors, radius, typeScale, zIndex } from "../../../src/tokens.generated";
import { href, pageMarkdown } from "../lib/site";

const lede = "Every value on this page is read from tokens/tokens.ts at build time. Colours are OKLCH; light is the default and dark is a `dark` class on the html element.";
const toc = [
  { id: "colours", label: "Colours" },
  { id: "type", label: "Type scale" },
  { id: "radius", label: "Radius" },
  { id: "layers", label: "Layers" },
];
const markdown = pageMarkdown({
  title: "Theming and tokens",
  description: lede,
  url: href("/theming"),
  body: [
    "## Colours",
    "| Token | Light | Dark |",
    "| --- | --- | --- |",
    ...colorNames.map((n) => `| --sb-${n} | ${colors.light[n]} | ${colors.dark[n]} |`),
    "## Type scale",
    ...Object.entries(typeScale).map(([n, s]) => `- ${n}: ${s.size}/${s.line}px, weight ${s.weight}`),
    "## Radius",
    ...Object.entries(radius).map(([n, r]) => `- ${n}: ${n === "full" ? "full" : `${r.px}px`}`),
    "## Layers",
    ...Object.entries(zIndex).map(([n, z]) => `- --sb-z-${n}: ${z}`),
  ],
});
---

<Docs title="Theming and tokens" description={lede} toc={toc}>
  <PageHead crumbs={[{ label: "Docs", href: href("/docs") }, { label: "Theming and tokens" }]} title="Theming and tokens" lede={lede} markdown={markdown} />
  <p>
    ikada is light unless a <code>dark</code> class is set on <code>&lt;html&gt;</code>, the shadcn and next-themes convention, for the npm theme and the shadcn theme alike.
    <code>data-theme="dark|light"</code> still works as a deprecated alias for one release. Use the theme switch in the header to compare.
  </p>

  <h2 id="colours">Colours</h2>
  <div class="props-wrap">
    <table class="props">
      <thead><tr><th scope="col">Token</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
      <tbody>
        {colorNames.map((n) => (
          <tr>
            <td>--sb-{n}</td>
            {[colors.light[n], colors.dark[n]].map((v) => (
              <td>
                <span style="display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;white-space:nowrap">
                  <span style={`width:20px;height:20px;flex:none;border-radius:5px;box-shadow:inset 0 0 0 1px oklch(0.5 0 0 / 0.3);background:${v}`} />
                  {v}
                </span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="type">Type scale</h2>
  <div class="stage" style="padding:16px 18px">
    <ul style="display:flex;flex-direction:column;gap:10px;list-style:none;margin:0;padding:0">
      {Object.entries(typeScale).map(([name, s]) => (
        <li style="display:flex;align-items:baseline;gap:16px;min-width:0">
          <span style="width:4rem;flex:none;font-family:var(--font-mono);font-size:12px;color:var(--sb-fg-muted)">{name}</span>
          <span style={`min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:${s.size / 16}rem;line-height:${s.line / 16}rem;font-weight:${s.weight};letter-spacing:${s.tracking}em`}>Deploy robin to production</span>
          <span style="margin-inline-start:auto;flex:none;font-family:var(--font-mono);font-size:12px;color:var(--sb-fg-muted)">{s.size}/{s.line}</span>
        </li>
      ))}
    </ul>
  </div>

  <h2 id="radius">Radius</h2>
  <ul style="display:grid;grid-template-columns:repeat(auto-fill,minmax(8rem,1fr));gap:12px;list-style:none;margin:16px 0 24px;padding:0">
    {Object.entries(radius).map(([name, r]) => (
      <li class="stage" style="margin:0;padding:12px;display:flex;flex-direction:column;gap:8px">
        <span style={`height:48px;background:var(--sb-hover);border-radius:${name === "full" ? "9999px" : `${r.px}px`}`} />
        <span style="font-family:var(--font-mono);font-size:12px">{name} · {name === "full" ? "full" : `${r.px}px`}</span>
      </li>
    ))}
  </ul>

  <h2 id="layers">Layers</h2>
  <p>Stacking order for everything that floats, lowest first.</p>
  <ul style="display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0 0 24px;padding:0">
    {Object.entries(zIndex).map(([name, z]) => <li class="chip">--sb-z-{name}: {z}</li>)}
  </ul>
  <p>Motion tokens have a page of their own: <a class="ilink" href={href("/motion")}>Motion</a>.</p>
  <Pager />
</Docs>
