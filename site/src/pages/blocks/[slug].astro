---
import CardGrid from "../../components/docs/CardGrid.astro";
import { Code } from "astro:components";
import BlockPreview from "../../components/BlockPreview";
import Install from "../../components/docs/Install.astro";
import PageHead from "../../components/docs/PageHead.astro";
import Pager from "../../components/docs/Pager.astro";
import PropsTable from "../../components/docs/PropsTable.astro";
import { Icon } from "../../components/icons";
import Docs from "../../layouts/Docs.astro";
import { propsTables } from "../../lib/props";
import { blockFiles, blocks } from "../../lib/registry";
import { blockHeightStyle } from "../../lib/block-heights";
import type { Item } from "../../lib/registry";
import { addCommands, fence, gzipKb, href, pagedDeps, pageMarkdown, registryJson, treeUrl, usesBaseUi } from "../../lib/site";
import type { TocEntry } from "../../lib/site";

export function getStaticPaths() {
  return blocks.map((item) => ({ params: { slug: item.name }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const files = blockFiles(item);
const uses = pagedDeps(item);
const tables = files.flatMap((f) => propsTables(f.source));
const commands = addCommands(item.name);
const id = "bs";

const toc: TocEntry[] = [
  { id: "preview", label: "Preview" },
  { id: "install", label: "Installation" },
  ...(uses.length ? [{ id: "uses", label: "Built from" }] : []),
  ...(tables.length ? [{ id: "props", label: "Props" }, ...tables.map((t) => ({ id: `props-${t.name}`, label: t.name, sub: true }))] : []),
];

const markdown = pageMarkdown({
  title: `${item.title} block`,
  description: item.description,
  url: href(`/blocks/${item.name}`),
  body: [
    "## Installation",
    fence(commands.npm, "sh"),
    `Built from: ${uses.map((u) => u.title).join(", ")}.`,
    ...files.flatMap((f) => [`## components/ikada/blocks/${item.name}/${f.name}`, fence(f.source)]),
  ],
});
---

<Docs title={item.title} description={item.description} toc={toc} wide>
  <PageHead
    crumbs={[{ label: "Docs", href: href("/docs") }, { label: "Blocks", href: href("/blocks") }, { label: item.title }]}
    title={item.title}
    lede={item.description}
    baseUi={usesBaseUi(item) || uses.some(usesBaseUi)}
    size={gzipKb(item)}
    source={treeUrl(`blocks/${item.name}`)}
    registry={registryJson(item.name)}
    markdown={markdown}
  />

  <section class="stage" data-bstage data-view="preview" id={id} aria-labelledby="preview">
    <div class="stage-bar">
      <h2 id="preview" class="ttl" style="margin:0;font-size:14px">Preview <small>Live, with the sample data the block ships with.</small></h2>
      <div class="right">
        <div class="seg vp-seg" role="radiogroup" aria-label="Preview width" data-seg data-role="vp">
          <button class="seg-btn" type="button" role="radio" aria-checked="true" data-value="full">Full</button>
          <button class="seg-btn" type="button" role="radio" aria-checked="false" data-value="768">768</button>
          <button class="seg-btn" type="button" role="radio" aria-checked="false" data-value="390">390</button>
        </div>
        <div class="seg" role="radiogroup" aria-label="View" data-seg data-role="view">
          <button class="seg-btn" type="button" role="radio" aria-checked="true" data-value="preview">Preview</button>
          <button class="seg-btn" type="button" role="radio" aria-checked="false" data-value="code">Code</button>
        </div>
        <button class="ibtn" type="button" data-stage-theme aria-pressed="false" aria-label="Preview in the other theme" title="Preview in the other theme"><Icon name="sun" /></button>
        <button class="copy" type="button" data-copy-file data-copy-from={`#${id}-src-0`} aria-label="Copy the file shown">
          <Icon name="copy" className="i i-copy" /><Icon name="check" className="i i-done" /><span class="lbl" aria-hidden="true">Copy</span>
        </button>
      </div>
    </div>
    <div class="bview" data-vp="full" data-scope data-demo>
      <div class="inner" data-reserve style={blockHeightStyle(item.name)}><BlockPreview client:only="react" slug={item.name} /></div>
    </div>
    <div class="stage-code">
      {
        files.length > 1 ? (
          <div class="file-tabs">
            <div class="seg" role="radiogroup" aria-label="File" data-seg data-role="file">
              {files.map((f, i) => (
                <button class="seg-btn" type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-value={String(i)}>
                  {f.name}
                </button>
              ))}
            </div>
          </div>
        ) : (
          <p class="file-name">components/ikada/blocks/{item.name}/{files[0]?.name}</p>
        )
      }
      {files.map((f, i) => (
        <div data-file={String(i)} hidden={i > 0} class="shiki-wrap" tabindex="0" aria-label={`components/ikada/blocks/${item.name}/${f.name}`}>
          <Code code={f.source} lang="tsx" themes={{ light: "github-light", dark: "github-dark-dimmed" }} defaultColor={false} wrap={false} />
          <template id={`${id}-src-${i}`} set:text={f.source} />
        </div>
      ))}
    </div>
  </section>

  <h2 id="install">Installation</h2>
  <Install commands={commands} />
  <p>
    Copies {files.map((f, i) => <>{i ? ", " : ""}<code>components/ikada/blocks/{item.name}/{f.name}</code></>)} into your project with the ikada theme. It is your
    code from then on: rename it, restyle it, and feed it your own data through its props.
  </p>

  {
    uses.length ? (
      <>
        <h2 id="uses">Built from</h2>
        <CardGrid kind="component" cards={uses.map((u) => ({ slug: u.name, title: u.title, href: href(`/components/${u.name}`), file: `${u.name}.tsx`, size: gzipKb(u) }))} />
      </>
    ) : null
  }

  {
    tables.length ? (
      <>
        <h2 id="props">Props</h2>
        {tables.map((t) => (
          <section id={`props-${t.name}`} aria-label={t.name}>
            <PropsTable table={t} />
          </section>
        ))}
      </>
    ) : null
  }

  <Pager />
</Docs>

<style is:global>
  [data-bstage][data-view="code"] .bview,
  [data-bstage]:not([data-view="code"]) .stage-code {
    display: none;
  }
  [data-bstage][data-view="code"] .vp-seg {
    visibility: hidden;
  }
  [data-bstage] .shiki-wrap {
    max-height: 36rem;
    overflow: auto;
    background: var(--sb-code-bg);
  }
  [data-bstage] .stage-code {
    background: var(--sb-code-bg);
  }
  [data-bstage] .file-name {
    margin: 0;
    padding: 10px 16px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--sb-fg-muted);
  }
  @media (max-width: 860px) {
    [data-bstage] .vp-seg {
      display: none;
    }
  }
</style>
