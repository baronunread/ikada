---
import { readFileSync } from "node:fs";
import { relative } from "node:path";
import Command from "../../components/Command.astro";
import Examples from "../../components/Examples";
import PropsTable from "../../components/PropsTable.astro";
import Docs from "../../layouts/Docs.astro";
import { propsTables } from "../../lib/props";
import { components, REGISTRY_URL, REPO_URL, sourcePath, srcDir } from "../../lib/registry";
import type { Item } from "../../lib/registry";

export function getStaticPaths() {
  return components.map((item) => ({ params: { slug: item.name }, props: { item } }));
}

const { item } = Astro.props as { item: Item };
const file = sourcePath(item);
const source = readFileSync(file, "utf8");
const tables = propsTables(source);
const exported = [...source.matchAll(/export function ([A-Z]\w*)/g)].map((m) => m[1]);
const from = file.includes("/charts/") ? "@sproutboat/ikada/charts" : "@sproutboat/ikada";
const repoPath = `src/${relative(srcDir, file)}`;
const deps = (item.registryDependencies ?? []).map((d) => d.split("/").pop()?.replace(/\.json$/, "")).filter((d) => d !== "theme");
---

<Docs title={item.title} description={item.description}>
  <article class="flex max-w-4xl flex-col gap-10">
    <header class="flex flex-col gap-2">
      <p class="text-sm text-fg-muted">Components</p>
      <h1 class="text-2xl">{item.title}</h1>
      <p class="max-w-2xl text-md font-normal text-fg-muted">{item.description}</p>
    </header>

    <section class="flex flex-col gap-3" aria-labelledby="examples">
      <h2 id="examples" class="text-lg">Examples</h2>
      <Examples client:load slug={item.name} />
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="install">
      <h2 id="install" class="text-lg">Installation</h2>
      <Command label="shadcn" code={`npx shadcn@latest add ${REGISTRY_URL}/${item.name}.json`} />
      <Command label="package" code={`import { ${exported.join(", ")} } from "${from}";`} />
      {deps.length ? <p class="text-sm text-fg-muted">Also installs: {deps.join(", ")}, and the ikada theme.</p> : null}
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="props">
      <h2 id="props" class="text-lg">Props</h2>
      {tables.length ? tables.map((t) => <PropsTable table={t} />) : <p class="text-fg-muted">No props interface; see the source.</p>}
    </section>

    <p class="text-sm text-fg-muted">
      Source: <a class="text-fg underline underline-offset-2" href={`${REPO_URL}/blob/main/${repoPath}`}>{repoPath}</a>
    </p>
  </article>
</Docs>
