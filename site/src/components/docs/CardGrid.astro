---
/**
 * The overview grids: a fixed-height inert preview on top, the name and, on one line, the file and
 * size below. The whole card is the link. Previews are server-rendered React (no JS); a few lines of
 * script scale each one to fit its box.
 */
import { BlockThumb, ComponentThumb } from "../Thumbs";

export interface Card {
  slug: string;
  title: string;
  href: string;
  file: string;
  size: string;
}
interface Props {
  cards: Card[];
  kind: "component" | "block";
}
const { cards, kind } = Astro.props;
---

<ul class:list={["cgrid", { "is-blocks": kind === "block" }]}>
  {cards.map((c) => (
    <li>
      <span class="cthumb" aria-hidden="true" inert>
        <span class="cfit" data-fit={kind === "block" ? "width" : "contain"}>
          {kind === "block" ? <BlockThumb slug={c.slug} /> : <ComponentThumb slug={c.slug} />}
        </span>
      </span>
      <span class="cmeta">
        <a href={c.href}>{c.title}</a>
        <small><span class="cfile">{c.file}</span><span class="csize">{c.size}<span class="sr-only"> gzipped</span></span></small>
      </span>
    </li>
  ))}
</ul>

<script>
  // Scale each inert preview to fit its box (a transform, never zoom). Components are contained and
  // centred; blocks fill the width and show their top.
  // Components share one scale (never above BASE) and only shrink to keep PAD of air on every side,
  // down to FLOOR (narrow 2-column cards go lower); blocks fill the width. Anything under FLOOR needs a narrower `thumb` export.
  const BASE = 0.8;
  const PAD = 16;
  const FLOOR = 0.6;
  const fit = (el: HTMLElement) => {
    const box = el.parentElement as HTMLElement;
    el.style.setProperty("--s", "1");
    const w = el.offsetWidth;
    const h = el.offsetHeight;
    if (!w || !h) return;
    let s: number;
    if (el.dataset.fit === "width") s = Math.min(1, (box.clientWidth - 2 * PAD) / w);
    else s = Math.max(Math.min(BASE, (box.clientWidth - 2 * PAD) / w, (box.clientHeight - 2 * PAD) / h), 0);
    el.style.setProperty("--s", s.toFixed(4));
    // a short block sits in the middle of the box instead of hugging the top
    const free = box.clientHeight - 2 * PAD - h * s;
    el.style.setProperty("--y", el.dataset.fit === "width" ? `${PAD + Math.max(0, free / 2)}px` : "0px");
    el.dataset.low = el.dataset.fit !== "width" && s < FLOOR ? "" : "x";
    if (el.dataset.low === "x") delete el.dataset.low;
    el.dataset.ready = "";
  };
  const all = [...document.querySelectorAll<HTMLElement>(".cfit")];
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target.firstElementChild as HTMLElement)));
  all.forEach((el) => {
    fit(el);
    ro.observe(el.parentElement as HTMLElement);
  });
</script>
