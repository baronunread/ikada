---
/** The component index: every component as a live thumbnail, its file and its gzipped size. */
import { sourcePath, components } from "../../lib/registry";
import { gzipKb, href } from "../../lib/site";
import CardGrid from "./CardGrid.astro";

const cards = components.map((c) => ({
  slug: c.name,
  title: c.title,
  href: href(`/components/${c.name}`),
  file: sourcePath(c).split("/").pop() ?? `${c.name}.tsx`,
  size: gzipKb(c),
}));
---

<CardGrid kind="component" cards={cards} />
