---
/** Deck's component index: every component as one file, with its gzipped size. */
import { sourcePath, components } from "../../lib/registry";
import { gzipKb, href } from "../../lib/site";

const cells = components.map((c) => ({ name: c.name, title: c.title, file: sourcePath(c).split("/").pop() ?? `${c.name}.tsx`, size: gzipKb(c) }));
---

<ul class="cindex">
  {cells.map((c) => (
    <li>
      <a href={href(`/components/${c.name}`)} aria-label={`${c.title}, ${c.file}, ${c.size} gzipped`}>
        <span>{c.title}</span>
        <small aria-hidden="true"><span>{c.file}</span><span>{c.size}</span></small>
      </a>
    </li>
  ))}
</ul>
